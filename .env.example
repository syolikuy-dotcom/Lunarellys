# Server & Pterodactyl Port Configuration
# On Pterodactyl, SERVER_PORT is injected automatically or set PORT to match your Allocation port (e.g. 4686)
PORT=3000
PUBLIC_BASE_URL=

# Optional API Key protection (comma-separated; leave empty for open plug-and-play access)
API_KEYS=
ADMIN_PASSCODE=
PUBLIC_DOCS=true

# Performance & Region
DEFAULT_REGION=ID
CORS_ORIGIN=*
CACHE_MAX_ENTRIES=500
CACHE_TTL_MS=300000
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info

# Optional Google OAuth (for cross-device library sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=